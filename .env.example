# REFERENCE ONLY — this file is NOT read by the application.
#
# There is no .env loading: set these as real environment variables in your hosting
# platform's dashboard, or inline (ACCESS_PASSWORD=... npm start). Copying this file
# to .env will have no effect.
#
# Every variable is optional and the server always starts; anything misconfigured is
# reported as a startup warning in the logs rather than crashing the process.

# HTTP port. Bonto sets this automatically in production.
PORT=3000

# Strongly recommended in production. Leave blank for open access (the server will
# start either way, but logs a prominent warning when it is unset).
ACCESS_PASSWORD=

# Comma-separated allowlist of hostnames (subdomains included). Empty = any public host.
# Example: ALLOWED_HOSTS=example.com,developer.mozilla.org
ALLOWED_HOSTS=

# Response cap in MB; upstream downloads exceeding this are aborted mid-stream.
MAX_RESPONSE_MB=25

# Request-body cap in MB (uploads through /api/*).
MAX_REQUEST_MB=25

# Upstream fetch timeout in milliseconds.
REQUEST_TIMEOUT_MS=20000

# Sliding-window rate limiter on /api/*.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Strict rate limiter on /auth/login (per IP).
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=5

# Session TTL for the proxy's own auth cookie.
SESSION_TTL_MS=604800000

# Signing secret for tamper-proof session ids. If unset a random one is generated at boot;
# set it explicitly if you run behind a load balancer with multiple instances.
SESSION_SECRET=

# Number of reverse-proxy hops in front of this app (0 = none, 1 = one balancer, etc.).
TRUST_PROXY_HOPS=1

# Logger level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Node environment. Setting NODE_ENV=production forces the auth cookie's Secure flag.
NODE_ENV=development

# Testing only. Disables the private/loopback half of the SSRF guard so the integration
# suite can proxy a fixture on 127.0.0.1. NEVER enable this on a deployment.
ALLOW_PRIVATE_TARGETS=false
